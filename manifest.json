{
  "manifest_version": 3,
  "name": "Media Downloader",
  "version": "1.0.0",
  "description": "Inyecta scripts de usuario en los sitios que tú eliges. Scripts actualizables desde GitHub.",
  "permissions": ["storage", "scripting", "downloads", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Media Downloader"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
